{
  "name": "servora-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servora - University service marketplace (Water, Laundry, Gas, Repairs). Express API + built React client served as one Render web service.",
  "main": "server/index.js",
  "scripts": {
    "dev": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently -n server,client -c blue,green \"npm run dev\" \"npm run dev:client\"",
    "start": "node server/index.js",
    "build": "cd client && rm -f package-lock.json && npm install --legacy-peer-deps && npm run build",
    "seed": "node seed.js",
    "db:push": "node run-schema.js",
    "db:migrate:documents": "node add-provider-documents.js",
    "db:migrate:professions": "node add-open-professions.js",
    "db:migrate:university": "node add-provider-university.js",
    "db:migrate:duration": "node add-order-duration.js",
    "db:migrate:references": "node add-provider-references.js",
    "db:migrate:push": "node add-push-subscriptions.js",
    "db:check": "node check-db.js",
    "render-build": "rm -f package-lock.json && npm install --legacy-peer-deps && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "resend": "^4.0.1",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
