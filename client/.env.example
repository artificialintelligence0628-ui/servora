# In dev, Vite proxies /api to the local server (see vite.config.js), so this
# usually doesn't need to change. Set it if you point the client at a deployed API.
VITE_API_BASE_URL=/api

# Public key only — safe to expose on the frontend. Secret key stays server-side.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
