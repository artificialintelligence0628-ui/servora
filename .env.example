# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (Neon Postgres) ----
# Get this from your Neon project dashboard. Include ?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/servora?sslmode=require

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Seed admin (used only by seed.js) ----
SEED_ADMIN_NAME=Servora Admin
SEED_ADMIN_EMAIL=admin@servora.app
SEED_ADMIN_PASSWORD=change-me-immediately

# ---- Cloudinary (file uploads: repair photos, provider ID docs, avatars) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend (transactional email: verification, password reset) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Servora <no-reply@yourdomain.com>

# ---- Paystack ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key is duplicated on the client with the VITE_ prefix, see client/.env.example
